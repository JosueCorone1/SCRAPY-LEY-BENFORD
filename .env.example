# Cookies de una sesion propia. Alternativa: boton Iniciar sesion en la app.
INSTAGRAM_COOKIES=
INSTAGRAM_REQUEST_INTERVAL_SECONDS=2
INSTAGRAM_RATE_LIMIT_COOLDOWN_SECONDS=900
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_MAX_SCROLLS=300

# Solo Big Five: los textos se envian a Google Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
